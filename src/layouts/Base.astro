---
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: object;
}

const { title, description, canonical, ogType = 'website', ogImage = '/img/og-card.jpg', jsonLd } = Astro.props;
const siteUrl = 'https://alohawindowbros.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="jAknsZKTerLm1bUE5GXkg2RY0w5TV0LCuWXvjpomvTU" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Aloha Window Bros" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Consent Mode v2: default = granted (US-only audience, no EU targeting). -->
    <!-- A returning visitor who previously clicked Decline gets denied state -->
    <!-- restored synchronously, so we honor their preference going forward. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var __awb_consent = null;
      try { __awb_consent = localStorage.getItem('awb-cookie-consent'); } catch (e) {}
      var __awb_denied = __awb_consent === 'declined';
      gtag('consent', 'default', {
        ad_storage: __awb_denied ? 'denied' : 'granted',
        ad_user_data: __awb_denied ? 'denied' : 'granted',
        ad_personalization: __awb_denied ? 'denied' : 'granted',
        analytics_storage: __awb_denied ? 'denied' : 'granted',
        functionality_storage: 'granted',
        security_storage: 'granted',
      });
      gtag('js', new Date());
      window.__awbConsentDenied = __awb_denied;
    </script>

    <!-- Google Analytics (GA4), fires immediately unless user previously declined -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MRSP8D9CQG"></script>
    <script is:inline>
      gtag('config', 'G-MRSP8D9CQG');
    </script>

    <!-- Meta Pixel, fires immediately unless user previously declined -->
    <script is:inline>
      if (!window.__awbConsentDenied) {
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '2085643305314161');
        fbq('track', 'PageView');
      }
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2085643305314161&ev=PageView&noscript=1"
    /></noscript>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- WebSite node: feeds Google's SERP "site name" so the brand still displays -->
    <!-- even though page titles intentionally drop the brand suffix. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Aloha Window Bros",
      "alternateName": "Aloha Window Brothers",
      "url": siteUrl
    })} />
  </head>
  <body>
    <slot name="header" />
    <slot />
    <slot name="footer" />
    <CookieBanner />

    <!-- Conversion tracking -->
    <script>
      document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';

        // Phone call clicks
        if (href.startsWith('tel:')) {
          gtag('event', 'phone_call', {
            event_category: 'conversion',
            event_label: href,
          });
        }

        // Email clicks
        if (href.startsWith('mailto:')) {
          gtag('event', 'email_click', {
            event_category: 'conversion',
            event_label: href,
          });
        }

        // Calendly / Free Quote clicks
        if (href.includes('calendly.com')) {
          gtag('event', 'quote_click', {
            event_category: 'conversion',
            event_label: link.textContent.trim(),
          });
        }

        // Google Reviews click
        if (href.includes('google.com/search') && href.includes('reviews')) {
          gtag('event', 'reviews_click', {
            event_category: 'engagement',
          });
        }
      });
    </script>
  </body>
</html>
