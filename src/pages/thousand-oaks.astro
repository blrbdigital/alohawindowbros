---
import CityLanding from '../components/CityLanding.astro';

const city = {
  slug: 'thousand-oaks',
  cityName: 'Thousand Oaks',
  shortName: 'Thousand Oaks',
  metaTitle: 'Window Cleaning & Washing Thousand Oaks, CA | Free Quote',
  metaDescription: 'Window cleaning and washing in Thousand Oaks, CA. Conejo Valley locals, fully insured. Most homes $150 to $400. Free on-site quote: (805) 341-4121.',
  heroHeadline: 'Window Cleaning in Thousand Oaks, CA',
  heroSubcopy: 'We grew up here. Westlake High alumni, two brothers, cleaning windows for our Thousand Oaks neighbors with the spirit of aloha and a 100% satisfaction guarantee.',
  intro: "Thousand Oaks is our home base. We started Aloha Window Bros to bring honest, professional window cleaning to the Conejo Valley, the place we grew up. From the older neighborhoods around Conejo Park to the newer Lang Ranch hillside builds, we know the dust, the sun exposure, and the hard water that Thousand Oaks homes deal with every season. Whether you're looking for window washing Thousand Oaks neighbors recommend or a full window cleaning service, it's the same complete job from us: exterior and interior glass, screens, frames, and sills. Most full-home services run $150 to $400 depending on size, with free on-site estimates.",
  soilingFactors: [
    { name: 'Santa Ana wind dust', detail: 'Fall and winter Santa Anas drive fine particulate from the surrounding canyons onto windows, especially on north- and east-facing glass in Lang Ranch, Wildwood, and the hills near Sunset Hills.' },
    { name: 'Hard sprinkler water', detail: 'California American Water supplies Thousand Oaks, and its 2025 water quality report puts total hardness at 140 mg/L, about 8.2 grains per gallon, on the State Water Project supply that makes up 94% of the city. Hard, but not very hard. The damage comes from how often sprinklers hit the glass, not from an extreme mineral load.' },
    { name: 'Inland heat and no marine layer', detail: 'Sitting inland of the Conejo Grade at roughly 890 feet, Thousand Oaks gets far less overnight marine layer than Oxnard or Ventura. Sprinkler water evaporates on the glass instead of staying damp, so minerals concentrate and bake onto south- and west-facing panes.' },
    { name: 'Oak pollen and leaf debris', detail: 'The namesake oaks drop pollen and tannins each spring that settle on screens and lower window panes, blocking views and clogging screen mesh.' }
  ],
  neighborhoods: [
    'Lang Ranch', 'Sunset Hills', 'Wildwood', 'Conejo Park',
