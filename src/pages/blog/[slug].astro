---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import { imageObject } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const PHONE = '(805) 341-4121';
const PHONE_LINK = 'tel:+18053414121';

// FAQPage schema is derived from the rendered FAQ markup in the markdown body,
// so the schema and the visible list can never drift apart. Same rule and same
// regex as src/pages/services/[slug].astro and the homepage `faqs` array (see
// .claude-site-map.md): add FAQ items to the markdown, never here. A post with
// no <details>/<summary> block simply emits no FAQPage node.
const stripTags = (s: string) => s.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const faqs: { q: string; a: string }[] = [];
const faqRe = /<summary>([\s\S]*?)<\/summary>\s*<p>([\s\S]*?)<\/p>/g;
let m: RegExpExecArray | null;
while ((m = faqRe.exec(post.body ?? '')) !== null) {
  faqs.push({ q: stripTags(m[1]), a: stripTags(m[2]) });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...(faqs.length ? [{
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }] : []),
    {
      "@type": "Article",
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.date,
      "author": { "@type": "Organization", "name": "Aloha Window Bros" },
      "publisher": { "@type": "Organization", "name": "Aloha Window Bros", "url": "https://alohawindowbros.com" },
      "mainEntityOfPage": `https://alohawindowbros.com/blog/${post.id}/`,
      ...(post.data.heroImage ? { "image": imageObject({ path: post.data.heroImage, caption: post.data.heroImageAlt || post.data.title }) } : {})
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alohawindowbros.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://alohawindowbros.com/blog/" },
        { "@type": "ListItem", "position": 3, "name": post.data.title, "item": `https://alohawindowbros.com/blog/${post.id}/` }
      ]
    }
  ]
};
---
<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  jsonLd={jsonLd}
>
  <Header slot="header" />

  {post.data.heroImage && (
    <figure class="blog-post-cover">
      <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} loading="eager" decoding="async" />
    </figure>
  )}

  <!-- Blog Post Hero -->
  <section class="blog-post-hero">
    <a href="/blog" class="service-back-link">← All Articles</a>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.date}>{new Date(post.data.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
  </section>

  <!-- Blog Content + Sidebar -->
  <section class="service-content-section">
    <article class="service-article">
      <div class="article-content">
        <Content />
      </div>
    </article>

    <aside class="service-sidebar">
      <div class="sidebar-card">
        <h3>Need Window Cleaning?</h3>
        <p>Schedule a free quote. We'll come to you.</p>
        <a href="/contact/" class="hero-cta-primary" style="width:100%;text-align:center;">Get a Free Quote</a>
        <div class="sidebar-divider"><span>or</span></div>
        <a href={PHONE_LINK} class="sidebar-phone">{PHONE}</a>
      </div>

      <div class="sidebar-card sidebar-services">
        <h4>Our Services</h4>
        <ul>
          <li><a href="/services/window-washing">Window Washing</a></li>
          <li><a href="/services/screen-cleaning">Screen Cleaning</a></li>
          <li><a href="/services/solar-panel-cleaning">Solar Panel Cleaning</a></li>
          <li><a href="/services/gutter-cleaning">Gutter Cleaning</a></li>
        </ul>
      </div>

      <div class="sidebar-card sidebar-services">
        <h4>Service Areas</h4>
        <ul>
          <li><a href="/ventura/">Window Cleaning Ventura</a></li>
          <li><a href="/santa-barbara/">Window Cleaning Santa Barbara</a></li>
          <li><a href="/oxnard/">Window Cleaning Oxnard</a></li>
          <li><a href="/camarillo/">Window Cleaning Camarillo</a></li>
          <li><a href="/thousand-oaks/">Window Cleaning Thousand Oaks</a></li>
          <li><a href="/simi-valley/">Window Cleaning Simi Valley</a></li>
        </ul>
      </div>

      <div class="sidebar-card sidebar-guarantee">
        <div class="sidebar-guarantee-icon">⭐</div>
        <h4>100% Satisfaction Guarantee</h4>
        <p>We walk the property with you before we leave. Not happy? We redo it on the spot.</p>
      </div>
    </aside>
  </section>

  <!-- Bottom CTA -->
  <section class="cta-banner">
    <h2>Ready for Crystal Clear Windows?</h2>
    <p>Get a free on-site quote from Aloha Window Bros today.</p>
    <a href="/contact/" class="cta-btn">Schedule Free Quote</a>
  </section>

  <Footer slot="footer" />
</Base>
